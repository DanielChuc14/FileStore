# Copiar a .env y completar con valores reales. NUNCA commitear el .env.
# Se usa con: docker compose -f docker-compose.prod.yml --env-file .env up -d

# --- PostgreSQL ---
POSTGRES_DB=filestore
# Rol dedicado, NO un superusuario. Ver DEPLOYMENT.md.
POSTGRES_USER=filestore
# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- JWT ---
# Generar con: openssl rand -base64 48
JWT_SECRET=

# --- Super-admin inicial ---
SUPERADMIN_EMAIL=admin@tudominio.com
# Generar con: openssl rand -base64 18
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# --- Correo (Resend) ---
# Clave de la API. Se crea en resend.com con permiso de envio.
# Si se deja vacia, la app arranca igual y los correos solo se registran en el
# log: util para un primer deploy, pero el alta de clientes no notifica a nadie.
RESEND_API_KEY=
# Remitente. Su dominio tiene que estar verificado en Resend (SPF/DKIM).
RESEND_FROM_ADDRESS=no-reply@tudominio.com
RESEND_FROM_NAME=FileStore

# --- Dominio y TLS ---
# Origen publico del panel, con https. Se usa para CORS.
PUBLIC_ORIGIN=https://filestore.tudominio.com
# Ruta en el host donde viven fullchain.pem y privkey.pem de Let's Encrypt.
CERTS_PATH=/etc/letsencrypt/live/filestore.tudominio.com

# --- Migraciones ---
# En el PRIMER deploy poner true para que la API cree el esquema al arrancar.
# Despues volver a false para que un deploy no altere el esquema en silencio.
APPLY_MIGRATIONS=false
