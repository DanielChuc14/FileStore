# Copiar a .env y ajustar. NUNCA commitear el .env real.

# --- PostgreSQL ---
POSTGRES_DB=filestore
POSTGRES_USER=filestore
POSTGRES_PASSWORD=filestore
POSTGRES_PORT=5432

# --- Backend ---
# La cadena de conexion real se inyecta por entorno en produccion.
# En desarrollo se lee de appsettings.Development.json.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=filestore;Username=filestore;Password=filestore

# Ruta base del almacenamiento fisico de archivos (seccion 9 del documento).
StoragePath=/var/lib/filestore

# --- JWT (Fase 2) ---
# Generar con: openssl rand -base64 48
JwtSecret=
JwtLifetimeMinutes=15
JwtRefreshLifetimeDays=7

# --- Defaults globales (seccion 11 del documento) ---
MaxFileSizeBytes=10485760
TrashRetentionDays=30
RateLimitDefaultPerMinute=100
