# Normaliza finales de linea. Sin esto, un editor en Windows puede commitear
# CRLF y romper archivos que Linux ejecuta.

# Por defecto, git decide y normaliza a LF en el repositorio.
* text=auto

# Estos SIEMPRE en LF: los ejecuta o interpreta Linux en el servidor.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binarios: git no los toca.
*.png       binary
*.jpg       binary
*.ico       binary
*.bin       binary
